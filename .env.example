# Skopiuj do .env i zmień wedle potrzeb. Każda wartość ma bezpieczną wartość domyślną.
# Komentarze zawsze w osobnej linii.

# Port na laptopie (http://localhost:PORT). Na RPi nakładka i tak wystawia 8000.
PORT=8090

# auto - prawdziwy sprzęt, gdy jest; symulacja całego demo, gdy NIC nie jest podłączone (domyślnie)
# sim  - zawsze symulacja (nawet z podłączonym sprzętem)
# real - nigdy symulacja (brakujące urządzenie = "Czekam na czujnik")
HW_MODE=auto

# --- Interakcja: dłoń -> koła ---
# strefa sterowania dłonią [m od kamery]; bliżej = szybciej
HAND_NEAR_M=0.35
HAND_FAR_M=1.20
# minimalny gaz w strefie (żeby koła wyraźnie ruszyły), ułamek 0..1
MIN_THROTTLE=0.25
# pięść = jazda do tyłu
ENABLE_REVERSE=1
# "przywołanie": robot sam kręci się w miejscu co ~20 s, gdy nikt nie pokazuje dłoni.
# Domyślnie wyłączone (wygląda jak usterka, na stole może być niebezpieczne); 1 = włącz
ATTRACT=0
ATTRACT_INTERVAL_S=20

# --- Ekran startowy: odwiedzający wybiera grę dłonią (najedź na kartę i przytrzymaj) ---
MENU=1
# jazda bez dłoni przez tyle sekund -> powrót do ekranu startowego
DRIVE_IDLE_S=8

# dłoń dalej niż tyle od kamery nie steruje (przechodnie za graczem)
PLAYER_MAX_DIST_M=1.7
# akumulatory 3S: ostrzeżenie w stopce / koła stoją
BATTERY_LOW_V=10.8
BATTERY_CRITICAL_V=10.2

# --- Gra: papier, kamień, nożyce (start: kciuk w górę albo klawisz G) ---
RPS=1
RPS_WINS=3
# limit rund na wypadek remisów (z RPS_WINS=0: stała liczba rund)
RPS_ROUNDS=9
# ostatnia runda: robot "podgląda" gest, wygrywa i po grze się przyznaje (powtórka z osią czasu)
RPS_CHEAT_LAST=1
# runda próbna bez punktów przed meczem ("Pokaż gest dopiero na TERAZ!")
RPS_WARMUP=1
# koła "pompują" w rytm odliczania i tańczą po rundzie (robot na podnośniku); prędkość [m/s]
RPS_WHEELS=0
RPS_WHEEL_SPEED=0.15
# wynik gry na ekraniku OLED łazika
OLED=1

# --- Jak widzi robot: głębia i podczerwień, gdy nikt nie steruje (klawisz L / dotyk) ---
VISION=1
# sceny po kolei (nazwa:sekundy): drive = obraz kolorowy, depth = głębia, ir = podczerwień
# (game = zaproszenie do gry – tylko gdy MENU=0)
VISION_SCENES=drive:10,depth:12
VISION_WIDTH=960

# --- Napęd ESP32 ---
# prędkość maksymalna kół [m/s] w komendzie {"T":1,"L":..,"R":..}
MAX_SPEED=0.5
# łagodny napęd (ochrona silników): rozpędzanie 0 -> max [s], zwykłe zatrzymanie [s],
# szybkie zatrzymanie po utracie obrazu z kamery [s], wygładzenie startu [s], postój przed zmianą kierunku [s]
# (STOP awaryjny radaru zawsze natychmiast)
RAMP_UP_S=1.6
RAMP_DOWN_S=0.8
STOP_FAST_S=0.3
SMOOTH_S=0.2
REVERSE_PAUSE_S=0.3
# 1 = koła mogą ruszać BEZ LiDAR-u (domyślnie nie – bezpieczniej)
DRIVE_WITHOUT_LIDAR=0
# komendy konfiguracyjne po połączeniu (rozdzielone ';', komendy ruchu są odrzucane):
# T:131 ciągła telemetria, T:136 heartbeat firmware'u [ms]
ESP32_INIT={"T":131,"cmd":1};{"T":136,"cmd":1000}
# typ podwozia wysyłany po każdym włączeniu (T:900). 1 = RaspRover (4 koła),
# 2 = UGV Rover, 3 = UGV Beast, 0 = nie wysyłaj. Zły typ = koła kręcą się w złą stronę.
ESP32_CHASSIS=1
# 1 = kamera patrzy w stronę tyłu podwozia (koła: odwrócony kierunek i zamienione strony).
# Nasz łazik: kamera od strony gniazda ładowania = tył podwozia, więc 1
# (bez tego otwarta dłoń jedzie do tyłu, a pięść do przodu).
DRIVE_FLIP=1

# --- Tarcza LiDAR (hamowanie awaryjne) ---
# promień strefy hamowania od środka LiDAR-u [m]
SHIELD_RADIUS=0.30
# o ile bliżej niż nauczone tło musi być przeszkoda [m]
SHIELD_MARGIN_M=0.10
# czas nauki tła po starcie [s]
SHIELD_LEARN_S=5
# przedmiot leżący nieruchomo przy robocie tyle sekund (koła stoją) staje się tłem; 0 = wyłączone
SHIELD_ABSORB_S=45
# zabrany przedmiot: tło wraca po tylu sekundach
SHIELD_FORGET_S=5
# brak świeżego skanu dłużej niż tyle [s] = koła stoją
LIDAR_STALE_S=0.5

# --- Montaż LiDAR-u ---
# obrót zera LiDAR-u względem przodu robota [stopnie]; zero LiDAR-u = strzałka na obudowie.
# Strzałka w prawo (patrząc w kierunku kamery) = -90, w lewo = 90, do tyłu = 180.
# Dokładną wartość ustawia kalibracja (5x logo Koła + hasło) – zapisuje ją w data/.
# nasz łazik (kamera od strony włącznika, DRIVE_FLIP=1): 90. Po przełożeniu kamery na drugą stronę +180
LIDAR_ANGLE_OFFSET_DEG=0
LIDAR_CLOCKWISE=1
LIDAR_MIN_INTENSITY=15

# --- Porty (puste = autodetekcja; wymuszaj tylko, gdy diagnostyka tego wymaga) ---
LIDAR_PORT=
# Raspberry Pi w RaspRoverze: /dev/ttyAMA0 (UART na GPIO) – tylko tą drogą ESP32 wykonuje
# komendy ruchu; port USB płytki (/dev/ttyACM0) daje tylko telemetrię. Ustawia to setup_rpi.sh.
ESP32_PORT=
# dodatkowe mostki USB-UART do sondowania, np. 0403:6001,10c4:*
SERIAL_EXTRA_IDS=
# 1 = sonduj wszystkie /dev/ttyUSB* i /dev/ttyACM*, nie tylko znane mostki
SERIAL_PROBE_ALL=0

# --- OAK-D Pro ---
# projektor kropek IR 0..1 (głębia na gładkich powierzchniach)
OAK_IR_DOT=0.3
# projektor tylko przy widoku "Głębia" (mniej ciepła kamery); 1 = świeci stale
OAK_IR_ALWAYS=0
# projektor przy widoku "Podczerwień" (-1 = jak OAK_IR_DOT). Kamera na jednym kablu z Pi: nie przesadzaj
OAK_IR_VIEW_DOT=-1
# co która klatka głębi / podczerwieni idzie na ekran (mniej = płynniej, ale więcej danych po USB)
OAK_VISION_EVERY_N=3
# lustrzany obraz dla odwiedzających (klawisz M przełącza lokalnie)
OAK_MIRROR=1
# model punktów dłoni: lite (dołączony)
OAK_LM_MODEL=lite
# punkty dłoni 3D w metrach: gest liczony z kątów w stawach (lepiej przy obróconej dłoni)
OAK_WORLD_LANDMARKS=1
# 1 = tryb zapasowy bez sieci NN (gaz z najbliższego obiektu w głębi)
OAK_FORCE_FALLBACK=0
# detekcja osób na VPU obok śledzenia dłoni (wyłącza się sama, gdy kamera nie daje rady)
OAK_PERSON_DETECT=1
# detektor osób liczy co N-tą klatkę (~7 razy/s przy N=4) – mniejsze N = więcej obciążenia VPU
OAK_PERSON_EVERY_N=4
OAK_PERSON_CONF=0.5
# do jakiej odległości radar śledzi ludzi [m]
PEOPLE_MAX_RANGE_M=4.0
# pozycja kamery względem środka LiDAR-u [m]: X do przodu, Y w lewo, Z w górę
CAM_OFFSET_X=0.10
CAM_OFFSET_Y=0.0
CAM_OFFSET_Z=-0.05

# obraz z kamery na ekran: szerokość [px], klatki/s, jakość JPEG (kamera daje 960 px i ~20 klatek/s)
STREAM_WIDTH=960
OAK_STREAM_FPS=25
JPEG_QUALITY=80
# czujnik i głębia w kamerze [klatki/s]: 22 wystarcza (śledzenie dłoni bierze najwyżej ~22), mniej ciepła; 0 = 29
OAK_INTERNAL_FPS=22

# przeglądarka w trybie kiosku na samym Raspberry (monitor podpięty do robota). 0 = bez kiosku: ekran ogląda się
# z laptopa pod http://lazik.local:8000, a Raspberry jest chłodniejsze (rysowanie strony brało ~1/4 procesora)
KIOSK=1
