# Skopiuj do .env i zmień wedle potrzeb. Wszystko ma rozsądne wartości domyślne.
# (Komentarze zawsze w osobnej linii.)

# Port dashboardu na hoście (http://localhost:PORT)
PORT=8000

# auto - wykrywa sprzęt, brakujące sensory symuluje (domyślnie)
# mock - wszystko symulowane, nawet gdy sprzęt jest podłączony
# real - tylko prawdziwy sprzęt (brakujący sensor = OFF, bez symulacji)
HW_MODE=auto

# Tryb ruchu:
#   stand - robot na podstawce, koła kręcą się w powietrzu (domyślny, bezpieczny)
#   mat   - delikatne ruchy na macie z wirtualną klatką LiDAR (ICP + geofence)
MOTION_MODE=stand

# --- Bezpieczeństwo LiDAR (metry, mierzone od obrysu robota) ---
# blokada ruchu w kierunku przeszkody
SAFETY_DISTANCE_M=0.25
# pełny STOP AWARYJNY
ESTOP_DISTANCE_M=0.12
# promień wirtualnej klatki (tryb mat)
GEOFENCE_RADIUS_M=0.20

# --- Napęd ---
# m/s w trybie stand (limit firmware Waveshare: 0.5)
MAX_WHEEL_SPEED=0.30
# m/s w trybie mat
MAT_MAX_WHEEL_SPEED=0.10
TRACK_WIDTH_M=0.17
WHEEL_DIAMETER_M=0.08

# --- Porty (puste = autodetekcja przez sondowanie protokołu) ---
LIDAR_PORT=
# na RPi 5 ESP32 zwykle siedzi na /dev/ttyAMA0 (UART na GPIO)
ROVER_PORT=

# --- LiDAR D500 (STL-19P): montaż ---
# obrót zera LiDAR-u względem przodu robota (stopnie)
LIDAR_ANGLE_OFFSET_DEG=0
LIDAR_CLOCKWISE=1

# --- OAK-D Pro ---
# projektor kropek IR 0..1 (lepsza głębia na gładkich powierzchniach)
OAK_IR_DOT=0.5
# lustrzany podgląd dla widzów
OAK_MIRROR=1

# --- Głowica pan-tilt (obraca się w stronę najbliższej osoby) ---
GIMBAL_ENABLED=1
GIMBAL_TILT_DEG=10
